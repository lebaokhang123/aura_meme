<mxfile host="app.diagrams.net" modified="2026-10-30T19:00:00.000Z" agent="AuraMeme M0.5" version="24.7.17" type="device"><diagram name="00 - API Boundary" id="overview"><mxGraphModel dx="1850" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="overview-title-1" value="&lt;b&gt;AURAMEME — API BOUNDARY (P0 / P1)&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontFamily=Arial;fontSize=21;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="150" y="28" width="1550" height="53" as="geometry" /></mxCell><mxCell id="overview-sub-2" value="Target design | One FastAPI modular monolith | One PostgreSQL database" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="91" width="1370" height="40" as="geometry" /></mxCell><mxCell id="overview-browser-3" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;React / Vite" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="58" y="295" width="402" height="136" as="geometry" /></mxCell><mxCell id="overview-nginx-4" value="&lt;b&gt;Nginx&lt;/b&gt;&lt;br&gt;HTTPS + /api/v1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="502" y="295" width="402" height="136" as="geometry" /></mxCell><mxCell id="overview-fastapi-5" value="&lt;b&gt;FastAPI&lt;/b&gt;&lt;br&gt;Auth / Blog / Aura / Vault / Admin" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="946" y="295" width="402" height="136" as="geometry" /></mxCell><mxCell id="overview-db-6" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;1 DB; Alembic migrations" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1390" y="295" width="402" height="136" as="geometry" /></mxCell><mxCell id="overview-link-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="overview-browser-3" target="overview-nginx-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="overview-link-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="overview-nginx-4" target="overview-fastapi-5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="overview-link-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="overview-fastapi-5" target="overview-db-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="overview-media-10" value="&lt;b&gt;Media files&lt;/b&gt;&lt;br&gt;local dev / object storage on prod" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1050" y="520" width="590" height="100" as="geometry" /></mxCell><mxCell id="overview-note-11" value="&lt;b&gt;P0 | Core Blog&lt;/b&gt;  Auth, Users, Posts, Categories, Comments, Media, Contact, Admin." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontFamily=Arial;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="80" y="690" width="1690" height="75" as="geometry" /></mxCell><mxCell id="overview-note-12" value="&lt;b&gt;P1 | AuraMeme&lt;/b&gt;  Reactions, Aura, Check-in, Leaderboard, Vault, Inventory.   &lt;b&gt;P2 | Deferred&lt;/b&gt;  Generator, Aura Plus / Prime payment." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontFamily=Arial;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="80" y="800" width="1690" height="85" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="01 - Auth and Session" id="auth"><mxGraphModel dx="1850" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="auth-title-1" value="&lt;b&gt;AUTHENTICATION &amp; SESSION — P0&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontFamily=Arial;fontSize=21;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="150" y="28" width="1550" height="53" as="geometry" /></mxCell><mxCell id="auth-sub-2" value="Cookie session | CSRF protection | Authorization on the backend" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="91" width="1370" height="40" as="geometry" /></mxCell><mxCell id="auth-csrf-3" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;GET /auth/csrf" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="58" y="280" width="313" height="142" as="geometry" /></mxCell><mxCell id="auth-request-4" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;POST /auth/login&lt;br&gt;X-CSRF-Token" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="413" y="280" width="313" height="142" as="geometry" /></mxCell><mxCell id="auth-verify-5" value="&lt;b&gt;Auth&lt;/b&gt;&lt;br&gt;validate + verify password" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="768" y="280" width="313" height="142" as="geometry" /></mxCell><mxCell id="auth-session-6" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;store token hash + expiry" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1123" y="280" width="313" height="142" as="geometry" /></mxCell><mxCell id="auth-cookie-7" value="&lt;b&gt;Response&lt;/b&gt;&lt;br&gt;Set-Cookie am_session" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1478" y="280" width="313" height="142" as="geometry" /></mxCell><mxCell id="auth-link-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="auth-csrf-3" target="auth-request-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="auth-link-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="auth-request-4" target="auth-verify-5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="auth-link-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="auth-verify-5" target="auth-session-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="auth-link-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="auth-session-6" target="auth-cookie-7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="auth-note-12" value="&lt;b&gt;Subsequent requests:&lt;/b&gt;  Browser GET /users/me → session cookie → backend hash lookup → user/roles from DB → UserPrivate response." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontFamily=Arial;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="80" y="555" width="1690" height="92" as="geometry" /></mxCell><mxCell id="auth-note-13" value="&lt;b&gt;Failure rules:&lt;/b&gt;  wrong password → 401; locked user → 403; invalid CSRF → 403; expired/revoked session → 401. Never return password_hash, token_hash or raw session token in JSON." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontFamily=Arial;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="80" y="710" width="1690" height="112" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="02 - Posts and Media" id="post"><mxGraphModel dx="1850" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="post-title-1" value="&lt;b&gt;POST / MEDIA — P0&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontFamily=Arial;fontSize=21;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="150" y="28" width="1550" height="53" as="geometry" /></mxCell><mxCell id="post-sub-2" value="Upload bytes and create metadata separately; post references media_id" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="91" width="1370" height="40" as="geometry" /></mxCell><mxCell id="post-m1-3" value="&lt;b&gt;1. Select image&lt;/b&gt;&lt;br&gt;React form" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="65" y="248" width="300" height="100" as="geometry" /></mxCell><mxCell id="post-m2-4" value="&lt;b&gt;2. POST /media&lt;/b&gt;&lt;br&gt;auth + CSRF + validate" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="465" y="248" width="360" height="100" as="geometry" /></mxCell><mxCell id="post-m3-5" value="&lt;b&gt;3. Store bytes&lt;/b&gt;&lt;br&gt;local/S3 object key" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="925" y="248" width="335" height="100" as="geometry" /></mxCell><mxCell id="post-m4-6" value="&lt;b&gt;4. Save metadata&lt;/b&gt;&lt;br&gt;media_uploads ready" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1360" y="248" width="370" height="100" as="geometry" /></mxCell><mxCell id="post-link-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="post-m1-3" target="post-m2-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="post-link-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="post-m2-4" target="post-m3-5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="post-link-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="post-m3-5" target="post-m4-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="post-p1-10" value="&lt;b&gt;5. POST /posts&lt;/b&gt;&lt;br&gt;title + category + media_id" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="65" y="516" width="390" height="112" as="geometry" /></mxCell><mxCell id="post-p2-11" value="&lt;b&gt;6. Validate&lt;/b&gt;&lt;br&gt;session + category&lt;br&gt;media ownership" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="555" y="516" width="380" height="112" as="geometry" /></mxCell><mxCell id="post-p3-12" value="&lt;b&gt;7. PostgreSQL&lt;/b&gt;&lt;br&gt;transaction INSERT posts" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1035" y="516" width="330" height="112" as="geometry" /></mxCell><mxCell id="post-p4-13" value="&lt;b&gt;8. Response&lt;/b&gt;&lt;br&gt;201 Post / 409 / 422" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1460" y="516" width="280" height="112" as="geometry" /></mxCell><mxCell id="post-link-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="post-p1-10" target="post-p2-11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="post-link-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="post-p2-11" target="post-p3-12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="post-link-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="post-p3-12" target="post-p4-13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="post-note-17" value="&lt;b&gt;Invariants:&lt;/b&gt;  one category and at most one image per post (P0); owner of uploaded media must equal author; if bytes were stored but DB write fails, use cleanup/reconciliation. No binary bytes inside PostgreSQL." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontFamily=Arial;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="80" y="770" width="1690" height="118" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="03 - Daily Checkin" id="checkin"><mxGraphModel dx="1850" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="checkin-title-1" value="&lt;b&gt;DAILY CHECK-IN / AURA — P1&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontFamily=Arial;fontSize=21;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="150" y="28" width="1550" height="53" as="geometry" /></mxCell><mxCell id="checkin-sub-2" value="Effective day starts at 07:00 Asia/Ho_Chi_Minh | Timestamp stored as UTC" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="91" width="1370" height="40" as="geometry" /></mxCell><mxCell id="checkin-request-3" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;POST /aura/check-in" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="58" y="305" width="254" height="140" as="geometry" /></mxCell><mxCell id="checkin-guard-4" value="&lt;b&gt;Backend&lt;/b&gt;&lt;br&gt;auth + CSRF" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="354" y="305" width="254" height="140" as="geometry" /></mxCell><mxCell id="checkin-day-5" value="&lt;b&gt;Calculate&lt;/b&gt;&lt;br&gt;VN07 effective_day" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="650" y="305" width="254" height="140" as="geometry" /></mxCell><mxCell id="checkin-lock-6" value="&lt;b&gt;Transaction&lt;/b&gt;&lt;br&gt;lock progress + wallet" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="946" y="305" width="254" height="140" as="geometry" /></mxCell><mxCell id="checkin-reward-7" value="&lt;b&gt;Ledger&lt;/b&gt;&lt;br&gt;unique day + XP + Khi Van" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1242" y="305" width="254" height="140" as="geometry" /></mxCell><mxCell id="checkin-return-8" value="&lt;b&gt;Response&lt;/b&gt;&lt;br&gt;streak / delta / day" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1538" y="305" width="254" height="140" as="geometry" /></mxCell><mxCell id="checkin-link-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="checkin-request-3" target="checkin-guard-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="checkin-link-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="checkin-guard-4" target="checkin-day-5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="checkin-link-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="checkin-day-5" target="checkin-lock-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="checkin-link-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="checkin-lock-6" target="checkin-reward-7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="checkin-link-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="checkin-reward-7" target="checkin-return-8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="checkin-note-14" value="&lt;b&gt;Idempotency:&lt;/b&gt; UNIQUE(user_id, effective_day). A repeated call for the same day returns the original result, without new XP, bonus, Khi Van or streak." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontFamily=Arial;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="80" y="590" width="1690" height="115" as="geometry" /></mxCell><mxCell id="checkin-note-15" value="&lt;b&gt;VIP fairness:&lt;/b&gt; earned_xp determines leaderboard and case odds. PLUS ×2 / PRIME ×3 only affect bonus_xp and level/frame progression. P1 runs at FREE ×1 until P2 entitlements exist." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontFamily=Arial;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="80" y="760" width="1690" height="116" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="04 - Vault Opening" id="vault"><mxGraphModel dx="1850" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="vault-title-1" value="&lt;b&gt;VAULT OPENING — P1&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontFamily=Arial;fontSize=21;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="150" y="28" width="1550" height="53" as="geometry" /></mxCell><mxCell id="vault-sub-2" value="Result is selected on backend BEFORE animation; retry returns the same result" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="91" width="1370" height="40" as="geometry" /></mxCell><mxCell id="vault-request-3" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;POST /vault/cases/{id}/open&lt;br&gt;Idempotency-Key" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="58" y="305" width="254" height="145" as="geometry" /></mxCell><mxCell id="vault-check-4" value="&lt;b&gt;Backend&lt;/b&gt;&lt;br&gt;session, limits&lt;br&gt;earned_xp only" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="354" y="305" width="254" height="145" as="geometry" /></mxCell><mxCell id="vault-odds-5" value="&lt;b&gt;Published pool&lt;/b&gt;&lt;br&gt;version + band + CSPRNG" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="650" y="305" width="254" height="145" as="geometry" /></mxCell><mxCell id="vault-debit-6" value="&lt;b&gt;Wallet&lt;/b&gt;&lt;br&gt;conditional debit + ledger" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="946" y="305" width="254" height="145" as="geometry" /></mxCell><mxCell id="vault-grant-7" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;case_open + item grant" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1242" y="305" width="254" height="145" as="geometry" /></mxCell><mxCell id="vault-response-8" value="&lt;b&gt;Commit&lt;/b&gt;&lt;br&gt;reward → UI animation" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1538" y="305" width="254" height="145" as="geometry" /></mxCell><mxCell id="vault-link-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="vault-request-3" target="vault-check-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="vault-link-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="vault-check-4" target="vault-odds-5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="vault-link-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="vault-odds-5" target="vault-debit-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="vault-link-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="vault-debit-6" target="vault-grant-7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="vault-link-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="vault-grant-7" target="vault-response-8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="vault-note-14" value="&lt;b&gt;Atomic:&lt;/b&gt; debit + case result + inventory grant in ONE DB transaction; no partial award or double spend. Same key + same request → same result; reused key + changed request → 409." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontFamily=Arial;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="80" y="610" width="1690" height="115" as="geometry" /></mxCell><mxCell id="vault-note-15" value="&lt;b&gt;Odds:&lt;/b&gt; server uses original earned_xp, not VIP multiplier. Each published rarity table totals 10000 bps; client may display published odds but cannot send cost, rarity or reward choice." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontFamily=Arial;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="80" y="774" width="1690" height="109" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="05 - Admin and Audit" id="admin"><mxGraphModel dx="1850" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="admin-title-1" value="&lt;b&gt;ADMIN AUTHORISATION — P0&lt;/b&gt;" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontFamily=Arial;fontSize=21;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="150" y="28" width="1550" height="53" as="geometry" /></mxCell><mxCell id="admin-sub-2" value="Never treat hidden React buttons as an access-control mechanism" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="91" width="1370" height="40" as="geometry" /></mxCell><mxCell id="admin-request-3" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;/api/v1/admin/*" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="58" y="305" width="254" height="145" as="geometry" /></mxCell><mxCell id="admin-session-4" value="&lt;b&gt;Auth&lt;/b&gt;&lt;br&gt;session + CSRF for writes" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="354" y="305" width="254" height="145" as="geometry" /></mxCell><mxCell id="admin-role-5" value="&lt;b&gt;RBAC&lt;/b&gt;&lt;br&gt;role ADMIN from DB" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="650" y="305" width="254" height="145" as="geometry" /></mxCell><mxCell id="admin-validate-6" value="&lt;b&gt;Domain logic&lt;/b&gt;&lt;br&gt;validation + safety rules" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="946" y="305" width="254" height="145" as="geometry" /></mxCell><mxCell id="admin-write-7" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;mutation + audit event" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1242" y="305" width="254" height="145" as="geometry" /></mxCell><mxCell id="admin-response-8" value="&lt;b&gt;Response&lt;/b&gt;&lt;br&gt;2xx / 4xx + request_id" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1538" y="305" width="254" height="145" as="geometry" /></mxCell><mxCell id="admin-link-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="admin-request-3" target="admin-session-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="admin-link-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="admin-session-4" target="admin-role-5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="admin-link-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="admin-role-5" target="admin-validate-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="admin-link-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="admin-validate-6" target="admin-write-7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="admin-link-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="admin-write-7" target="admin-response-8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="admin-note-14" value="&lt;b&gt;Denied:&lt;/b&gt; Guest → 401; User without ADMIN → 403; invalid owner/target/status → 403/404/409 as appropriate. No mutation and no false success response." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontFamily=Arial;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="80" y="600" width="1690" height="110" as="geometry" /></mxCell><mxCell id="admin-note-15" value="&lt;b&gt;Audit:&lt;/b&gt; role changes, lock/unlock, post moderation, category changes and contact handling record actor, target and before/after safely. Never log password hashes or session tokens." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontFamily=Arial;fontSize=17;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent=