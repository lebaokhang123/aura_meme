=Arial;fontSize=14;spacing=7;" vertex="1" parent="1"><mxGeometry x="1087" y="642" width="207" height="83" as="geometry" /></mxCell><mxCell id="m04-local-dev-note" value="DEV: Vite không phải web server production; CORS/proxy phải được cấu hình đúng; migration Alembic chạy với DB tương ứng." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;fontColor=#111111;strokeWidth=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;spacing=13;" vertex="1" parent="1"><mxGeometry x="82" y="880" width="702" height="98" as="geometry" /></mxCell><mxCell id="m04-local-compose-note" value="COMPOSE: `api` kết nối DB bằng host `db`, KHÔNG dùng `localhost` trong container. Không publish port DB ra Internet." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;fontColor=#111111;strokeWidth=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;spacing=13;" vertex="1" parent="1"><mxGeometry x="839" y="880" width="702" height="98" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="02 - AWS V1 Deployment" id="m04-aws"><mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1090" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="m04-aws-ec2" value="&lt;b&gt;AWS EC2 — Single host&lt;/b&gt;&lt;br&gt;Security Group: public 80/443; SSH hạn chế IP hoặc SSM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#222222;fontColor=#111111;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=15;spacingTop=13;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="544" y="156" width="757" height="690" as="geometry" /></mxCell><mxCell id="m04-aws-e0" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=0;html=1;strokeColor=#111111;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitD