5;" edge="1" parent="1" source="m04-aws-postgres" target="m04-aws-volume"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="m04-aws-e6" value="Media bytes" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=0;html=1;strokeColor=#111111;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=5 5;" edge="1" parent="1" source="m04-aws-api" target="m04-aws-s3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="m04-aws-e7" value="Off-host copies" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=0;html=1;strokeColor=#111111;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=5 5;" edge="1" parent="1" source="m04-aws-volume" target="m04-aws-backup"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="m04-aws-header-title" value="M0.4 / 02 — AWS V1 Deployment (TARGET)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#111111;fontFamily=Arial;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="42" y="26" width="1550" height="45" as="geometry" /></mxCell><mxCell id="m04-aws-header-sub" value="Đề xuất tối giản: 1 EC2 + Compose + PostgreSQL private · Manual deploy trước Terraform · Chưa tạo AWS resource" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#333333;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="42" y="73" width="1550" height="40" as="geometry" /></mxCell><mxCell id="m04-aws-internet" value="&lt;b&gt;Internet&lt;/b&gt;&lt;br&gt;Guest / User" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;fontColor=#111111;strokeWidth=1.4;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=8;" vertex="1" parent="1"><mxGeometry x="54" y="310" width="165" height="116" as="geometry" /></mxCell><mxCell id="m04-aws-dns" value="&lt;b&gt;DNS&lt;/b&gt;&lt;br&gt;Tên miền" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;fontColor=#111111;strokeWidth=1.4;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=8;" vertex="1" parent="1"><mxGeometry x="270" y="315" width="180" height="106" as="geometry" /></mxCell><mxCell id="m04-aws-nginx" value="&lt;b&gt;Nginx&lt;/b&gt;&lt;br&gt;HTTPS / TLS&lt;br&gt;Static React build" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;fontColor=#111111;strokeWidth=1.4;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=8;" vertex="1" parent="1"><mxGeometry x="607" y="270" width="232" height="142" as="geometry" /></mxCell><mxCell id="m04-aws-api" value="&lt;b&gt;FastAPI container&lt;/b&gt;&lt;br&gt;Internal /api&lt;br&gt;Auth / business logic" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;fontColor=#111111;strokeWidth=1.4;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=8;" vertex="1" parent="1"><mxGeometry x="608" y="464" width="232" height="117" as="geometry" /></mxCell><mxCell id="m04-aws-postgres" value="&lt;b&gt;PostgreSQL container&lt;/b&gt;&lt;br&gt;Docker private network&lt;br&gt;KHÔNG expose 5432" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;fontColor=#111111;strokeWidth=1.4;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=8;" vertex="1" parent="1"><mxGeometry x="607" y="650" width="232" height="123" as="geometry" /></mxCell><mxCell id="m04-aws-frontend-static" value="Static UI bundle&lt;br&gt;dist/ → Nginx" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;strokeWidth=1.2;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;spacing=7;" vertex="1" parent="1"><mxGeometry x="980" y="290" width="240" height="95" as="geometry" /></mxCell><mxCell id="m04-aws-volume" value="EBS / Docker volume&lt;br&gt;DB persistence (disk)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;strokeWidth=1.2;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;spacing=7;" vertex="1" parent="1"><mxGeometry x="981" y="668" width="240" height="92" as="geometry" /></mxCell><mxCell id="m04-aws-s3" value="&lt;b&gt;S3 (mục tiêu)&lt;/b&gt;&lt;br&gt;Ảnh upload production&lt;br&gt;Không lưu trong image" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;fontColor=#111111;strokeWidth=1.4;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=8;" vertex="1" parent="1"><mxGeometry x="1371" y="468" width="220" height="124" as="geometry" /></mxCell><mxCell id="m04-aws-backup" value="&lt;b&gt;Backup ngoại máy&lt;/b&gt;&lt;br&gt;+ Kiểm thử restore&lt;br&gt;Chưa triển khai" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;fontColor=#111111;strokeWidth=1.4;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=8;" vertex="1" parent="1"><mxGeometry x="1371" y="680" width="220" height="118" as="geometry" /></mxCell><mxCell id="m04-aws-ops" value="&lt;b&gt;An toàn vận hành:&lt;/b&gt; IAM quyền tối thiểu/MFA; budget alert; không đưa secret vào Git/image; chỉ tin forwarded headers từ Nginx." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;fontColor=#111111;strokeWidth=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;spacing=13;" vertex="1" parent="1"><mxGeometry x="61" y="885" width="1510" height="84" as="geometry" /></mxCell><mxCell id="m04-aws-slo" value="&lt;b&gt;Giới hạn:&lt;/b&gt; một EC2 = single point of failure, không HA. RDS/ALB/K8s chỉ cân nhắc khi cần và có ngân sách." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;fontColor=#111111;strokeWidth=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;spacing=13;" vertex="1" parent="1"><mxGeometry x="61" y="988" width="1506" height="62" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="03 - Delivery and Operations" id="m04-delivery"><mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1090" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="m04-delivery-ci-panel" value="&lt;b&gt;DELIVERY PIPELINE&lt;/b&gt;&lt;br&gt;GitHub Actions + image registry + deploy có kiểm soát" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#222222;fontColor=#111111;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=15;spacingTop=13;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="59" y="157" width="1517" height="360" as="geometry" /></mxCell><mxCell id="m04-delivery-ops-panel" value="&lt;b&gt;OPERATIONS&lt;/b&gt;&lt;br&gt;Logs, metrics, alarm, backup/restore — cấu hình khi đến milestone" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#222222;fontColor=#111111;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=15;spacingTop=13;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="59" y="555" width="1517" height="317" as="geometry" /></mxCell><mxCell id="m04-delivery-e0" value="PR / push" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=0;html=1;strokeColor=#111111;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m04-delivery-branch" target="m04-delivery-checks"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="m04-delivery-e1" value="Tests PASS" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=0;html=1;strokeColor=#111111;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m04-delivery-checks" target="m04-delivery-registry"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="m04-delivery-e2" value="SHA-tag image" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=0;html=1;strokeColor=#111111;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m04-delivery-registry" target="m04-delivery-deploy"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="m04-delivery-e3" value="Health &amp; smoke" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=0;html=1;strokeColor=#111111;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m04-delivery-deploy" target="m04-delivery-verify"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="m04-delivery-e4" value="Correlation" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=0;html=1;strokeColor=#111111;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=5 5;" edge="1" parent="1" source="m04-delivery-logs" target="m04-delivery-metrics"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="m04-delivery-e5" value="Thresholds" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=0;html=1;strokeColor=#111111;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m04-delivery-metrics" target="m04-delivery-alarms"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="m04-delivery-e6" value="Runbook" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=0;html=1;strokeColor=#111111;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=5 5;" edge="1" parent="1" source="m04-delivery-alarms" target="m04-delivery-backups"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="m04-delivery-header-title" value="M0.4 / 03 — Delivery &amp; Operations (TARGET)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#111111;fontFamily=Arial;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="42" y="26" width="1550" height="45" as="geometry" /></mxCell><mxCell id="m04-delivery-header-sub" value="CI/CD + vận hành dự kiến sau khi manual AWS thành công · Quy trình release chưa chốt do dev và main có lịch sử độc lập" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#333333;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="42" y="73" width="1550" height="40" as="geometry" /></mxCell><mxCell id="m04-delivery-branch" value="&lt;b&gt;Feature branch&lt;/b&gt;&lt;br&gt;Code / review" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;fontColor=#111111;strokeWidth=1.4;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=8;" vertex="1" parent="1"><mxGeometry x="85" y="276" width="220" height="118" as="geometry" /></mxCell><mxCell id="m04-delivery-checks" value="&lt;b&gt;CI: GitHub Actions&lt;/b&gt;&lt;br&gt;Lint · Typecheck&lt;br&gt;Tests · Build · Scan" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;fontColor=#111111;strokeWidth=1.4;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=8;" vertex="1" parent="1"><mxGeometry x="355" y="263" width="240" height="142" as="geometry" /></mxCell><mxCell id="m04-delivery-registry" value="&lt;b&gt;Image registry&lt;/b&gt;&lt;br&gt;Immutable tag: SHA" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;fontColor=#111111;strokeWidth=1.4;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=8;" vertex="1" parent="1"><mxGeometry x="651" y="276" width="225" height="118" as="geometry" /></mxCell><mxCell id="m04-delivery-deploy" value="&lt;b&gt;EC2 deployment&lt;/b&gt;&lt;br&gt;Pull image&lt;br&gt;Run migration carefully" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;fontColor=#111111;strokeWidth=1.4;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=8;" vertex="1" parent="1"><mxGeometry x="936" y="263" width="256" height="142" as="geometry" /></mxCell><mxCell id="m04-delivery-verify" value="&lt;b&gt;Verify release&lt;/b&gt;&lt;br&gt;Health · Smoke test&lt;br&gt;Rollback procedure" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;fontColor=#111111;strokeWidth=1.4;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=8;" vertex="1" parent="1"><mxGeometry x="1250" y="263" width="270" height="142" as="geometry" /></mxCell><mxCell id="m04-delivery-logs" value="&lt;b&gt;Application logs&lt;/b&gt;&lt;br&gt;Structured errors&lt;br&gt;Request ID" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;fontColor=#111111;strokeWidth=1.4;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=8;" vertex="1" parent="1"><mxGeometry x="100" y="657" width="277" height="120" as="geometry" /></mxCell><mxCell id="m04-delivery-metrics" value="&lt;b&gt;Host + DB metrics&lt;/b&gt;&lt;br&gt;Latency / 5xx&lt;br&gt;CPU / RAM / disk" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;fontColor=#111111;strokeWidth=1.4;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=8;" vertex="1" parent="1"><mxGeometry x="476" y="657" width="285" height="120" as="geometry" /></mxCell><mxCell id="m04-delivery-alarms" value="&lt;b&gt;Alerts&lt;/b&gt;&lt;br&gt;API down, disk full&lt;br&gt;Error spikes" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;fontColor=#111111;strokeWidth=1.4;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=8;" vertex="1" parent="1"><mxGeometry x="860" y="657" width="282" height="120" as="geometry" /></mxCell><mxCell id="m04-delivery-backups" value="&lt;b&gt;Backup verification&lt;/b&gt;&lt;br&gt;Restore drill&lt;br&gt;Data recovery" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;fontColor=#111111;strokeWidth=1.4;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=8;" vertex="1" parent="1"><mxGeometry x="1238" y="657" width="287" height="120" as="geometry" /></mxCell><mxCell id="m04-delivery-release-note" value="&lt;b&gt;Quy tắc release:&lt;/b&gt; `dev` và `main` hiện là hai lịch sử Git độc lập. Không giả định PR `dev → main` hoạt động; owner duyệt chiến lược chuyển nhánh chính khi phiên bản V1 sẵn sàng." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;fontColor=#111111;strokeWidth=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;spacing=13;" vertex="1" parent="1"><mxGeometry x="66" y="900" width="1497" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>