# Copy to .env and replace the placeholder locally. Never commit real credentials.
# Percent-encode reserved characters in the username/password (e.g. @ becomes %40).
DATABASE_URL=postgresql+psycopg://aurameme:CHANGE_ME@127.0.0.1:5432/aurameme
DB_CONNECT_TIMEOUT=5
# Required for Auth. Generate a random key locally; never commit its value.
AUTH_SIGNING_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
# Secure cookies and HTTPS origins are required in production (the default).
# Development HTTP is allowed only for explicit loopback origins.
AUTH_ENVIRONMENT=development
AUTH_ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:5173"]
# Optional integration target; M1.4/M2.1 tests may migrate aurameme_test only.
# Not loaded automatically into the test process; see README.
# TEST_DATABASE_URL=postgresql+psycopg://aurameme:CHANGE_ME@127.0.0.1:5432/aurameme_test
# Optional private absolute path; omitted defaults to backend/.local/media/.
# MEDIA_STORAGE_ROOT=D:/private/aurameme-media
